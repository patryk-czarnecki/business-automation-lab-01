{
  "name": "business-automation-lab-01",
  "version": "1.0.0",
  "description": "Learning project for business automation and system integrations",
  "homepage": "https://github.com/patryk-czarnecki/business-automation-lab-01#readme",
  "bugs": {
    "url": "https://github.com/patryk-czarnecki/business-automation-lab-01/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patryk-czarnecki/business-automation-lab-01.git"
  },
  "license": "UNLICENSED",
  "author": "Patryk Czarnecki",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "prisma:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate deploy --config prisma7.config.ts",
    "db:status": "prisma migrate status --config prisma7.config.ts",
    "db:dev": "prisma migrate dev --config prisma7.config.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node scripts/test-integration.js"
  },
  "private": true,
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^7.10.1"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
